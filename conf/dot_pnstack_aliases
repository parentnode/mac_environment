apache() {

	php_version=$(port installed | grep -oE 'php8[0-9]-fpm' | sed 's/php//; s/-fpm//')
	if [ "$1" = "restart" ]; then
		sudo port reload php$php_version-fpm
		sudo /opt/local/sbin/apachectl restart
	elif [ "$1" = "stop" ]; then
		sudo port unload php$php_version-fpm
		sudo /opt/local/sbin/apachectl stop
	elif [ "$1" = "start" ]; then
		sudo port load php$php_version-fpm
		sudo /opt/local/sbin/apachectl start
	else
		sudo /opt/local/sbin/apachectl $1
	fi
}

alias zipmac="zip -r zip . -x */.*"
