# DO NOT MODIFY THIS FILE – CHANGES WILL BE OVERWRITTEN ON UPDATES
# INSTEAD PUT YOUR CUSTOMIZATIONS IN .zshrc


# Include aliases for easy updating
source /srv/tools/conf/dot_pnstack_aliases


# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion


# GIT
if [[ ! -e "/Users/$(echo $USER)/.gitconfig" || -z  $(git config --global user.name) ]]; then

	echo ""
	echo "Your git credentials are missing"
	echo ""

	read "git_username?git user name: "
	read "git_email?git email: "
	git config --global core.filemode false
	git config --global user.name "$git_username"
	git config --global user.email "$git_email"
	git config --global credential.helper cache
fi


# Available updates

if [ ! -d "/opt/local/var/db/mariadb-10.11" ]; then

	alias upgrade-mariadb="/srv/tools/scripts/maintenance/upgrade-mariadb.sh"
	echo ""
	echo "MariaDB upgrade to 10.11 available – run upgrade-mariadb to upgrade now"

fi


fpm=$(port installed | grep 'php8[0-9]-fpm')
if [ -z "$fpm" ]; then

	alias upgrade-http2-php-fpm="/srv/tools/scripts/maintenance/upgrade-http2-php-fpm.sh"
	echo ""
	echo "PHP FPM and Apache HTTP/2 upgrade available – run upgrade-http2-php-fpm to upgrade now"

fi


php85=$(port installed | grep 'php85')
if [ -z "$php85" ]; then

	alias upgrade-php="/srv/tools/scripts/maintenance/upgrade-php.php"
	echo ""
	echo "PHP85 upgrade available – run upgrade-php to upgrade now"

fi


echo ""
